# --- SwiftyCare API — Environment Variables ---
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# MongoDB connection string (required)
# Local:   mongodb://localhost:27017/swiftycare
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/swiftycare?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/swiftycare

# OpenAI API key (required for AI summary & diagnosis features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server port (default: 3001)
PORT=3001

# Allowed CORS origins (comma-separated, optional)
# Leave empty to use built-in defaults (localhost, demo.swifty-care.com, tunnel domains)
CORS_ORIGINS=

# --- Authentication (required in production) ---
# Secret used to sign session JWTs. Min 16 chars. The server REFUSES to start in
# production without it. Generate e.g.: openssl rand -hex 48
JWT_SECRET=

# Optional token lifetimes (defaults: staff 12h, patient case token 3h)
# STAFF_TOKEN_TTL=12h
# PATIENT_CASE_TOKEN_TTL=3h
# BCRYPT_ROUNDS=12

# --- Staff account seeding ---
# On boot, accounts are created from these (passwords are hashed, never stored
# in plaintext). Existing accounts are never overwritten. In production NOTHING
# is seeded unless you provide credentials here.
ADMIN_USERNAME=
ADMIN_PASSWORD=
DOCTOR_USERNAME=
DOCTOR_PASSWORD=
NURSE_USERNAME=
NURSE_PASSWORD=
# 'intake' is the kiosk/registration role allowed to create cases (patient intake)
INTAKE_USERNAME=
INTAKE_PASSWORD=
